NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fincontrol
DB_USERNAME=root
DB_PASSWORD=

# Troque por uma frase longa e aleatoria antes de publicar.
JWT_SECRET=fincontrol-local-troque-esta-chave
JWT_EXPIRES_IN=7d

# Link de recuperação; use a URL pública do aplicativo em produção.
APP_BASE_URL=http://localhost:3000

# SMTP é necessário para entregar links por e-mail em produção.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FINCONTROL <no-reply@fincontrol.local>
